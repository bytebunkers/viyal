void main() {
    print("Testing for-range:");
    for i in 0..5 {
        print(i);
    }
    
    print("Testing for-in (Array):");
    var arr = [10, 20, 30];
    for x in arr {
        print(x);
    }

    print("Testing for-in (String):");
    var s = "hey";
    for c in s {
        print(c);
    }
}
